# Copy to configs/local.env (gitignored). Use absolute paths on your machine.
# This file is sourced as shell code by launchers. Do not commit credentials.
ROBOTWIN_PYTHON=python3
YAML_PY=python3
SIM_GPU=0
GPU=1
EPISODES=50
ROBOTWIN_FROZEN_SEEDS=1
ROBOTWIN_VIDEO_FIRST_N=10
# Paths below are required only for the backend you select.
# AHAWAM_CKPT=/path/to/ahawam_ckpt
# AHAWAM_ROOT=/path/to/ahawam_root
# AHAWAM_STATS=/path/to/ahawam_stats
# DIFFSYNTH_MODEL_BASE_PATH=/path/to/diffsynth_model_base_path
# DM05_MODEL=/path/to/dm05_model
# FASTWAM_CKPT=/path/to/fastwam_ckpt
# FASTWAM_ROOT=/path/to/fastwam_root
# FASTWAM_STATS=/path/to/fastwam_stats
# G05_ROOT=/path/to/g05_root
# LB_CKPT=/path/to/lb_ckpt
# LB_DIR=/path/to/lb_dir
# MOTUS_CKPT=/path/to/motus_ckpt
# MOTUS_ROOT=/path/to/motus_root
# MOTUS_VLM=/path/to/motus_vlm
# MOTUS_WAN=/path/to/motus_wan
# OPENDM_DIR=/path/to/opendm_dir
# OPENDM_ENV=/path/to/opendm_env
# OPENPI=/path/to/openpi
# OPENWAM_CKPT=/path/to/openwam_ckpt
# OPENWAM_DIR=/path/to/openwam_dir
# PI05_CKPT=/path/to/pi05_ckpt
# PI0_CKPT=/path/to/pi0_ckpt
# STARVLA_CKPT=/path/to/starvla_ckpt
# STARVLA_DIR=/path/to/starvla_dir
# TOKENIZERS_PARALLELISM=/path/to/tokenizers_parallelism
# WLA_MODEL_ID=/path/to/wla_model_id
# WLA_ROOT=/path/to/wla_root
# XVLA_CKPT=/path/to/xvla_ckpt
# XVLA_DIR=/path/to/xvla_dir
# XWAM_EXP=/path/to/xwam_exp
# XWAM_ROOT=/path/to/xwam_root
# XWAM_WAN_DIR=/path/to/xwam_wan_dir
